# Build output
target/
build/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Measurement data: only manifests and aggregated CSV files are versioned.
# Dry runs stay local. Artifacts and job logs are raw data of the runs, kept
# outside Git. Both contain the Maven output with the commit metadata.
data/dryrun/
data/*/artifacts/
data/*/job-logs/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS and IDE
.DS_Store
.idea/
.vscode/
*.iml

# Secrets and key material (signing is keyless)
.env
*.pem
*.key
*.p12
*.jks
*kubeconfig*
